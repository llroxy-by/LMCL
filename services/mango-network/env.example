# Copy values into your process supervisor/secret manager; this service never reads .env files.
HOST=127.0.0.1
PORT=8787
# Required: replace at runtime with a random value of at least 32 characters. This placeholder is not a secret.
TOKEN_PEPPER=replace-with-runtime-secret-at-least-32-chars
VERIFICATION_TTL_MS=600000
ACCESS_TTL_MS=900000
REFRESH_TTL_MS=2592000000
MAX_SNAPSHOT_BYTES=10485760
