{
  "name": "lmcl",
  "version": "0.1.0-preview.3",
  "description": "通用 Minecraft Java 启动器",
  "author": "llroxy",
  "main": "app/main.mjs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test core/test/*.test.mjs app/test/*.test.mjs",
    "smoke": "electron . --smoke-test",
    "build:win": "electron-builder --win portable --x64 --publish never",
    "build:mac": "electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.github.llroxy-by.lmcl",
    "productName": "LMCL",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "app/**",
      "core/src/**",
      "examples/**",
      "package.json",
      "!app/test/**"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "LMCL-${version}-windows-x64.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "artifactName": "LMCL-${version}-mac-arm64.${ext}",
      "category": "public.app-category.games",
      "minimumSystemVersion": "13.0",
      "identity": "-",
      "notarize": false
    },
    "dmg": {
      "title": "LMCL ${version}",
      "sign": false
    }
  }
}
